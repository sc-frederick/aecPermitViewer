{
  "name": "hillsborough-permit-monitor",
  "productName": "Permit Monitor",
  "version": "0.10.1",
  "private": true,
  "description": "Local Windows and macOS permit status monitor for selected Florida building authorities",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p infra/sync-server",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "smoke:portal": "npm run build && node scripts/smoke-portal.mjs",
    "browser:stage": "node scripts/stage-browsers.mjs",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-forge package --platform win32 --arch x64",
    "make:win": "npm run build && electron-forge make --platform win32 --arch x64",
    "package:mac": "npm run build && electron-forge package --platform darwin --arch arm64",
    "dev": "npm run build && electron .",
    "sync:windows": "bash scripts/sync-windows.sh",
    "benchmark:history": "vitest run tests/history-growth.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "playwright": "1.63.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/windows-sign": "1.2.2",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "24.10.1",
    "electron": "44.4.5",
    "esbuild": "0.25.12",
    "oxlint": "1.85.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@electron-forge/cli": {
      "tar": "7.5.22",
      "tmp": "0.2.7"
    }
  }
}
