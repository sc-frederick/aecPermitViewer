{
  "name": "permitmon-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "minify": true,
  // The app uses workers.dev: aeccloud.io has Bot Fight Mode on, which challenges non-browser clients.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ShareRoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoomObject"] }]
}
